<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════════
         VOICE & MICROPHONE (Module 1 Core)
         ═══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ═══════════════════════════════════════════════════════════════
         TELEPHONY & SMS (Stage 8 & Stage 9)
         Declared now so manifest merges cleanly; runtime-requested on first use.
         ═══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- ═══════════════════════════════════════════════════════════════
         CAMERA & FLASHLIGHT (Stage 11)
         ═══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <!-- ═══════════════════════════════════════════════════════════════
         NOTIFICATIONS (API 33+) & NOTIFICATION LISTENER
         ═══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ═══════════════════════════════════════════════════════════════
         FOREGROUND SERVICE
         ═══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+: Declare the exact service type for microphone usage -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- ═══════════════════════════════════════════════════════════════
         SYSTEM SETTINGS
         ═══════════════════════════════════════════════════════════════ -->
    <!-- Required for SET_BRIGHTNESS — user must grant via Settings panel -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ═══════════════════════════════════════════════════════════════
         NETWORK (for optional cloud NLU / future Retrofit usage)
         ═══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ═══════════════════════════════════════════════════════════════
         BIOMETRIC
         ═══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- ═══════════════════════════════════════════════════════════════
         WAKE LOCK (foreground service keeps processor awake while listening)
         ═══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ═══════════════════════════════════════════════════════════════
         VIBRATE (haptic feedback on command recognition)
         ═══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ═══════════════════════════════════════════════════════════════
         RECEIVE BOOT (restart service after reboot)
         ═══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

        <!-- Package visibility for discovering launchable installed apps (Android 11+ / API 30+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vnd.youtube" />
        </intent>
    </queries>

    <application
        android:name=".CypherApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cypher"
        tools:targetApi="31">

        <!-- ──────────────────────────────────────────────────────────
             Main Entry Point
             ────────────────────────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cypher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ──────────────────────────────────────────────────────────
             Voice Assistant Foreground Service (Stage 14)
             ────────────────────────────────────────────────────────── -->
        <service
            android:name=".services.voice.VoiceAssistantService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            tools:ignore="Instantiatable" />

        <!-- ──────────────────────────────────────────────────────────
             Notification Listener Service (Stage 12)
             Requires user to grant in Settings > Special App Access.
             ────────────────────────────────────────────────────────── -->
        <service
            android:name=".services.notification.CypherNotificationListenerService"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ──────────────────────────────────────────────────────────
             Accessibility Service (Stage 15 — justified usages only)
             Requires user to grant in Settings > Accessibility.
             ────────────────────────────────────────────────────────── -->
        <service
            android:name=".services.accessibility.CypherAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
